<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>CR Remote</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <!-- The broker's /pair page (button and QR) carries crremote://pair?broker=…&token=… -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>uk.krodity.crremote.pair</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>crremote</string>
            </array>
        </dict>
    </array>
    <!-- The broker is plain HTTP inside the tailnet. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>NSCameraUsageDescription</key>
    <string>Scan the pairing QR code shown by the broker.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>CR Remote talks to cr-broker on your computer.</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>
